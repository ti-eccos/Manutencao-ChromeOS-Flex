{
  "manifest_version": 3,
  "name": "Kit ECCOS | ChromeOS Flex",
  "version": "0.2.6",
  "description": "Coleta automática de informações disponíveis do dispositivo ChromeOS Flex para a equipe de tecnologia ECCOS.",
  "update_url": "https://ti-eccos.github.io/Manutencao-ChromeOS-Flex/chromeos-flex/updates.xml",
  "permissions": [
    "system.cpu",
    "system.memory",
    "system.storage",
    "enterprise.deviceAttributes",
    "enterprise.hardwarePlatform"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir inventário ECCOS"
  }
}
